<mxfile host="drawio">
  <diagram name="zones" id="zones">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="760" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- External zone -->
        <mxCell id="z_ext" value="Extern (nicht vertrauenswürdig)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;arcSize=6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="10" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s_inet" value="Internet, ISP,&lt;br&gt;Partnernetze" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="385" y="35" width="170" height="75" as="geometry" />
        </mxCell>

        <!-- Firewall -->
        <mxCell id="fw" value="&lt;b&gt;Firewall&lt;/b&gt; (oder HA-Cluster)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Default Deny zwischen den Zonen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- DMZ zone -->
        <mxCell id="z_dmz" value="DMZ (geringes Vertrauen)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;arcSize=6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="170" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_dmz" value="&lt;b&gt;DMZ&lt;/b&gt;&lt;br&gt;Reverse Proxy, Mail-Relay,&lt;br&gt;VPN-Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- Management zone -->
        <mxCell id="z_mgmt" value="Management (am sensibelsten)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;arcSize=6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s_mgmt" value="&lt;b&gt;MGMT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="185" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_backup" value="&lt;b&gt;BACKUP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_sec" value="&lt;b&gt;SEC&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="250" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- Internal zone -->
        <mxCell id="z_int" value="Intern (vertrauenswürdig)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;arcSize=6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="380" width="530" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s_srv" value="&lt;b&gt;SERVER&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="30" y="415" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_infra" value="&lt;b&gt;CLIENT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="415" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_clt" value="&lt;b&gt;WLAN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="415" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_prt" value="&lt;b&gt;PRINT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="30" y="480" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_voice" value="&lt;b&gt;PHONE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="480" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Untrusted internal zone -->
        <mxCell id="z_unt" value="Intern, nicht vertrauenswürdig" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;arcSize=6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="350" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s_guest" value="&lt;b&gt;GUEST&lt;/b&gt;&lt;br&gt;Gäste-WLAN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="430" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_iot" value="&lt;b&gt;IOT&lt;/b&gt;&lt;br&gt;Kameras, TVs, Sensoren" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="765" y="430" width="145" height="70" as="geometry" />
        </mxCell>

        <!-- Links: every zone hangs off the firewall -->
        <mxCell id="e_ext" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1" source="z_ext" target="fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dmz" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1" source="z_dmz" target="fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mgmt" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1" source="z_mgmt" target="fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_int" style="endArrow=none;html=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="fw" target="z_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_unt" style="endArrow=none;html=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="fw" target="z_unt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="330" />
              <mxPoint x="755" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Rules -->
        <mxCell id="rules" value="&lt;b&gt;Regeln zwischen den Zonen&lt;/b&gt;&lt;br&gt;• Verbindungen werden von mehr zu weniger Vertrauen aufgebaut, nie umgekehrt&lt;br&gt;• Nicht vertrauenswürdige Netze (Gäste, IoT) werden wie das Internet behandelt&lt;br&gt;• Das Management verbindet sich zu allem, nichts verbindet sich hinein&lt;br&gt;• Alles, was nicht ausdrücklich erlaubt ist, ist verboten" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;rounded=1;strokeColor=#999999;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="10" y="580" width="920" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
